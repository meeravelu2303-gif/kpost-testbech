# Normalise line endings — LF in the repo, so Windows checkouts don't churn diffs or break CI.
* text=auto eol=lf

# Shell scripts must stay LF even on Windows.
*.sh text eol=lf

# Binary assets — never diff or line-ending-convert these.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.xlsx binary
*.xls binary
*.7z binary
*.zip binary
*.woff binary
*.woff2 binary

# Generated / vendored — collapse in diffs and exclude from language stats.
package-lock.json linguist-generated=true
swagger.json linguist-generated=true
**/swagger.json linguist-generated=true
**/*.swagger.json linguist-generated=true
**/*.generated.ts linguist-generated=true
