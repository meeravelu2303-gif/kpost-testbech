# KPOST API bench — environment template. Copy to .env and fill in (.env is gitignored).
#
# Auth rule: credentials go here, tokens NEVER. A kpostID + password are stable facts; a
# bearer token is derived state (24h lifetime, per-host, per-device) minted per run and
# cached in .auth/session.json. Pasting a token in is what broke this suite once — it expires
# mid-run while the report still publishes.
#   npm run auth:diagnose   why can't I log in?
#   npm run auth:check      will the suite authenticate? (~5s preflight)

# --- Target (the account must exist in THIS backend; accounts don't travel between hosts) ---
BASE_URL=http://localhost:8989
API_TIMEOUT=60000
# TEST_WORKERS=4

# --- QA account (PERSONAL sender) ---
# Tier is sent as loginRO.userType: PERSONAL for @kpostindia.com, BUSINESS_S/_M/_L for a
# <handle>@<uniqueName>.kpost.in identity. Wrong tier fails before credential validation.
QA_KPOST_ID=
QA_PASSWORD=
QA_USER_TYPE=PERSONAL
QA_COUNTRY_ID=1

# --- Admin account (BUSINESS sender · companyAdministration/enterprise suites) ---
QA_ADMIN_KPOST_ID=
QA_ADMIN_PASSWORD=
QA_ADMIN_USER_TYPE=BUSINESS_S

# --- Messaging receivers (real accounts, referenced by kpostID) ---
# Victim doubles as the personal receiver and the ownership/IDOR counterparty — it must own
# data QA_KPOST_ID must not see, or the IDOR tests silently pass on the caller's own data.
QA_VICTIM_KPOST_ID=
QA_BUSINESS_RECEIVER_KPOST_ID=

# --- Session ---
TOKEN_REFRESH_SKEW_SECONDS=600
# Abort when no session can be established rather than publish coverage that never ran.
# Set to 1 only when the unauthenticated surface is deliberately what you measure.
ALLOW_UNAUTHENTICATED_RUN=0
# QA_AUTH_TOKEN — DO NOT SET. One-off escape hatch for an account whose password you lack;
# never refreshed, never cached, so it dies mid-run. Use QA_KPOST_ID/QA_PASSWORD instead.

# --- OTP / pinned test targets (never faker — a real 10-digit number is a real subscriber) ---
TEST_MOCK_OTP=123456
TEST_MOCK_OTP_FALLBACK=000000
TEST_MOBILE=9000000430
TEST_EMAIL=qa-test@example.com
TEST_COUNTRY_ID=1

VERBOSE_AUTH_DIAGNOSTICS=true

# --- Reporting: QA Dashboard (key embeds the app slug; unset → run not ingested) ---
DASHBOARD_INGEST_URL=http://localhost:8081/api/ingest
DASHBOARD_API_KEY=

# --- Reporting: Bugzilla (KPost API product; unset key → writes files, files nothing) ---
# DRY_RUN filing is irreversible — start true, lift once the first tickets look right.
BUGZILLA_API_KEY=
BUGZILLA_URL=http://192.168.0.50/rest
BUGZILLA_PRODUCT=KPost API
BUGZILLA_VERSION=unspecified
BUGZILLA_CLIENT_ALIAS=true
BUGZILLA_DRY_RUN=true
BUGZILLA_MAX_FILE=0
# File only real API defects, not test-failure (Assertion Failure) records.
BUGZILLA_FILE_ASSERTION_FAILURES=false

# --- KPOST database (read-only; scripts/seed only, never the suite) ---
KPOST_DB_HOST=127.0.0.1
KPOST_DB_PORT=3306
KPOST_DB_USER=root
KPOST_DB_PASSWORD=
KPOST_DB_NAME=kpost_testdb
