# KPOST Admin Module bench — environment template. Copy to .env and fill in (gitignored).
#
# ⚠ The admin surface holds real company HR data. Against a production target run
# refusal-path/read-only only (`npm run test:no-onboarding`) and keep BUGZILLA_DRY_RUN=true.

# --- Target ---
BASE_URL=http://localhost:9595
API_TIMEOUT=30000
TEST_WORKERS=4

# --- Authentication ---
# Admin login (userDetails/login) returns identity only, no token. Preferred: paste a real
# access token. Fallback (when empty): the bench mints an HS256 token from ADMIN_JWT_SECRET +
# the identity below — the secret must match the server's key or the token is rejected and the
# run drops to unauthenticated. It is base64-decoded before signing: enter it exactly.
QA_AUTH_TOKEN=
ADMIN_JWT_SECRET=kJuImTaErN0D9R0A7
ADMIN_JWT_TTL_SECONDS=3600
# Identity baked into a minted token; companyID selects the tenant-scoped data.
QA_KPOST_ID=qa.admin
QA_COMPANY_ID=1001
# Login-contract credentials only (login yields no usable session token on this module).
QA_USER_ID=
QA_PASSWORD=

# --- OTP / test data (never faker — a random 10-digit number is a real subscriber) ---
TEST_MOCK_OTP=123456
TEST_MOCK_OTP_FALLBACK=000000
TEST_MOBILE=9000000430
TEST_EMAIL=qa-test@example.com
# dialCode is an integer on the Admin OTP schemas (a quoted string yields 400).
TEST_DIAL_CODE=91
VERBOSE_AUTH_DIAGNOSTICS=true

# --- Run knobs ---
# TEST_ENV: report/dashboard grouping label (inferred from BASE_URL when unset; alias ENVIRONMENT).
TEST_ENV=
# QA_ENGINEER: name on the report header (alias TESTER).
QA_ENGINEER=
KPOST_RUN_RETENTION=20
KPOST_VECTOR_THRESHOLD=98
# fault (default) = one ticket per backend fault; endpoint = also key on METHOD /path. Migration.
KPOST_GROUPING=fault
# Run-validity floor — a run executing fewer than this many tests publishes nothing. Set in CI.
KPOST_MIN_TESTS=0

# --- Dispatchers (all optional; each skips cleanly when unset) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
SMTP_SECURE=
DEV_EMAIL_RECIPIENTS=
WEBHOOK_URL=
TRACKER_API_KEY=
PLANE_API_URL=
PLANE_WORKSPACE_SLUG=
PLANE_PROJECT_ID=
REDMINE_API_URL=
REDMINE_PROJECT_ID=

# --- Reporting: QA Dashboard (app kpost-admin; unset key → run not ingested) ---
DASHBOARD_INGEST_URL=http://localhost:8081/api/ingest
DASHBOARD_API_KEY=

# --- Reporting: Bugzilla (KPost Admin product; components named after Swagger tags) ---
# Filing is irreversible — DRY_RUN ships true; lift once check:integrations is clean and a
# capped first pass is reviewed. Unset key → the filer skips.
BUGZILLA_URL=http://192.168.0.50/bugzilla/rest
BUGZILLA_API_KEY=
BUGZILLA_PRODUCT=KPost Admin
BUGZILLA_VERSION=unspecified
BUGZILLA_DRY_RUN=true
BUGZILLA_MAX_FILE=0
# Component used when a defect's tag has no matching component; must itself exist.
BUGZILLA_FALLBACK_COMPONENT=admin-module-application
# Aliases are unique across the whole instance — this bench's prefix is KAD (API bench = KPA).
BUGZILLA_CLIENT_ALIAS=false
BUGZILLA_ALIAS_PREFIX=KAD

# --- One-time provisioning (npm run provision:integrations; unset for normal runs) ---
# Product/component creation needs an admin key with editcomponents; each component needs a
# default assignee (a real Bugzilla login). Dashboard provisioning logs in as an admin user.
BUGZILLA_ADMIN_API_KEY=
BUGZILLA_DEFAULT_ASSIGNEE=
DASHBOARD_ADMIN_EMAIL=
DASHBOARD_ADMIN_PASSWORD=
