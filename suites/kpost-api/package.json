{
  "name": "kpost-api",
  "version": "1.0.0",
  "description": "Playwright API test automation framework for the KPOST Communication Platform API",
  "scripts": {
    "test": "playwright test",
    "test:unit": "playwright test --config=playwright.unit.config.ts",
    "test:auth": "playwright test --project=auth",
    "test:profile": "playwright test --project=profile",
    "test:common": "playwright test --project=common",
    "test:integrations": "playwright test --project=integrations",
    "generate": "node scripts/generate/generateModuleOwnership.js",
    "typecheck": "tsc --noEmit",
    "verify:open": "node scripts/bugzilla/verify-open-bugs.js",
    "report": "playwright show-report reports/diagnostic",
    "seed": "node scripts/run-seed.js",
    "test:dashboard": "playwright test --project=dashboardV2",
    "test:knews": "playwright test --project=knews",
    "test:settings": "playwright test --project=generalSettings",
    "test:groups": "playwright test --project=groupsV2",
    "test:admin": "playwright test --project=companyAdministration",
    "test:contacts": "playwright test --project=contactsDirectoryV2",
    "test:kword": "playwright test --project=kwordDocuments",
    "test:kpresentation": "playwright test --project=kpresentation",
    "test:kdiary": "playwright test --project=kdiary",
    "test:kall": "playwright test --project=kallV2",
    "test:redbus": "playwright test --project=redbus",
    "test:katchup": "playwright test --project=katchupV2",
    "report:executive": "node scripts/report/print-executive-path.js",
    "notify": "node scripts/report/print-digest.js",
    "scorecard": "tsc reporters/generate-scorecard.ts --ignoreConfig --module commonjs --target es2022 --esModuleInterop --skipLibCheck --types node --outDir .scorecard-build && npx playwright test --list --reporter=json > .scorecard-build/test-list.json && node .scorecard-build/generate-scorecard.js .scorecard-build/test-list.json",
    "test:list": "playwright test --list --reporter=json",
    "clean": "node scripts/clean.js",
    "test:no-signup": "playwright test --grep-invert \"signupLogin/signup|ForMediumAndLarge/signup|adminRegistration|addingUserByAdmin|addingUserForReallocateByAdmin\"",
    "audit:vectors": "tsc scripts/audit-vectors.ts --ignoreConfig --module commonjs --target es2022 --esModuleInterop --skipLibCheck --types node --outDir .audit-build && node .audit-build/audit-vectors.js",
    "bugzilla:file": "tsc reporters/dashboard-bugzilla.ts --ignoreConfig --module commonjs --target es2022 --esModuleInterop --skipLibCheck --types node --outDir .bugzilla-build && node .bugzilla-build/dashboard-bugzilla.js",
    "pretest": "npm run audit:vectors",
    "test:skip-audit": "playwright test",
    "bugzilla:reconcile": "node scripts/bugzilla/reconcile-bugzilla-duplicates.js",
    "auth:check": "playwright test --config=scripts/auth-check/auth-check.config.ts",
    "auth:diagnose": "node scripts/auth/diagnose-login.js",
    "auth:diagnose:all": "node scripts/auth/diagnose-login.js --all-hosts",
    "auth:reset": "node -e \"require('fs').rmSync('.auth',{recursive:true,force:true});console.log('[auth] cached session cleared')\"",
    "bugzilla:close-fixed": "node scripts/bugzilla/close-fixed-bugzilla-bugs.js",
    "bugzilla:kmail:close-fixed": "node scripts/bugzilla/close-fixed-kmail.js",
    "bugzilla:relabel:kpost": "node scripts/bugzilla/relabel-input-validation.js --bench .",
    "bugzilla:relabel:admin": "node scripts/bugzilla/relabel-input-validation.js --bench admin",
    "bugzilla:repair-refiled": "node scripts/bugzilla/repair-refiled-bugzilla-bugs.js",
    "dashboard:push": "tsc reporters/dashboard-ingest.ts --ignoreConfig --module commonjs --target es2022 --esModuleInterop --skipLibCheck --types node --outDir .dashboard-build && node .dashboard-build/dashboard-ingest.js",
    "generate:token-derived": "node scripts/generate/generateTokenDerived.js",
    "seed:disposable": "node scripts/seed/seed-disposable-accounts.js",
    "test:kmail": "cd kmail && npx playwright test",
    "test:kmail:list": "cd kmail && npx playwright test --list --reporter=line",
    "typecheck:kmail": "cd kmail && npx tsc --noEmit",
    "test:adminmodule": "cd admin && npx playwright test",
    "test:adminmodule:list": "cd admin && npx playwright test --list --reporter=line",
    "typecheck:adminmodule": "cd admin && npx tsc --noEmit"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26.2.0",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@faker-js/faker": "^10.5.0",
    "dotenv": "^17.4.2",
    "jsonwebtoken": "^9.0.3",
    "zod": "^4.4.3"
  }
}
