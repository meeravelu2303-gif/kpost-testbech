# KMail API bench — environment template. Copy to .env and fill in (.env is gitignored).
#
# Two hosts, deliberately: KMail is a separate service but issues no credentials of its own,
# so the suite logs in against KPOST_AUTH_BASE_URL and presents the token to KMAIL_BASE_URL.
# Auth rule: credentials go here, tokens never — minted per run, cached under .auth/.

# --- Targets ---
KMAIL_BASE_URL=http://localhost:9081
KPOST_AUTH_BASE_URL=http://192.168.1.176:8989
API_TIMEOUT=30000
# TEST_WORKERS=4

# --- QA account ---
# Tier is sent as loginRO.userType: PERSONAL for @kpostindia.com, BUSINESS_S/_M/_L otherwise.
QA_KPOST_ID=
QA_PASSWORD=
QA_USER_TYPE=PERSONAL
QA_COUNTRY_ID=1
# Second real account — the ownership/IDOR victim. Must own mail the caller must not see.
QA_VICTIM_KPOST_ID=
# QA_DEVICE_ID — optional; derived from (KPOST_AUTH_BASE_URL, QA_KPOST_ID) when unset.

# --- Session ---
AUTH_STATE_FILE=.auth/session.json
TOKEN_REFRESH_SKEW_SECONDS=600
ALLOW_UNAUTHENTICATED_RUN=false
VERBOSE_AUTH_DIAGNOSTICS=true

# --- Send behaviour (KMail DELIVERS REAL MAIL — recipients default to synthetic addresses) ---
# Domain the synthetic addresses are built under; point it somewhere you control or unroutable.
QA_SYNTHETIC_MAIL_DOMAIN=kpostindia.com
# Bulk send is the highest fan-out write in the API — opt-in only.
ALLOW_BULK_SEND=false
# Largest attachment the suite constructs, in MB (limit specs assert the bound, don't exceed it).
MAX_ATTACHMENT_MB=6

# --- Reporting: Bugzilla (KMail API product; unset key → files nothing) ---
# DRY_RUN filing is irreversible — start true, lift once the first tickets look right.
BUGZILLA_URL=http://192.168.0.50/rest
BUGZILLA_API_KEY=
BUGZILLA_PRODUCT=KMail API
BUGZILLA_VERSION=5.0
BUGZILLA_DRY_RUN=true
BUGZILLA_MAX_FILE=0
BUGZILLA_UI_BASE_URL=http://localhost:5173

# --- Reporting: QA Dashboard (key embeds the app slug; unset → run not ingested) ---
DASHBOARD_INGEST_URL=http://localhost:8081/api/ingest
DASHBOARD_API_KEY=
