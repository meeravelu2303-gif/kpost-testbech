# ---------------------------------------------------------------------------
# KPost UI Automation — Environment Configuration Template
# Copy this file to `.env` and fill in values. `.env` is gitignored.
# All values here are safe placeholders — never commit real credentials.
# ---------------------------------------------------------------------------

# ---- Environment label ----
# The short CODE this run is filed under on the QA Dashboard: Local | QA |
# Staging | Production. It is NEVER a URL — the target URL is BASE_URL below and
# is reported separately.
#
# Leave it UNSET and the label is inferred from BASE_URL's host (localhost /
# 127.0.0.1 / 192.168.* -> Local; *stag*|*uat* -> Staging; *qa*|*test*|*dev* ->
# QA; *prod*|*live* -> Production; anything else -> Unknown). Set it only to
# override that inference. Spelling is normalised, so `local` and `Local` are the
# same environment.
#
# This must agree with the API bench (../KPOST-AUTOMATION-v1): the dashboard
# groups runs by this exact string, so `local` there and `Local` here would split
# one environment across two rows. See src/utils/environment.ts.
TEST_ENV=

# Base URL of the KPost React app under test.
#
# ⚠ THIS MUST BE A SECURE CONTEXT. KPost initialises a service worker without
# checking that one exists, so on a plain-HTTP LAN address (`http://192.168.x.x:3000`)
# `navigator.serviceWorker` is undefined, the app throws before its first paint,
# and EVERY test fails 90 seconds into global setup against a blank white page
# that still answers HTTP 200. Verified 2026-08-27.
#
# Use `http://localhost:3000` (browsers treat localhost as secure even over HTTP)
# or an `https://` origin if the dev server was started with HTTPS=true.
BASE_URL=http://localhost:3000

# API base URL (shared with the existing API automation ecosystem)
API_BASE_URL=http://localhost:3000/api

# ---- Authentication strategy for shared storage state ----
# api = fast API login (default); ui = drive the real login form once
AUTH_MODE=api
# Login endpoint, relative to API_BASE_URL (POST { email, password })
AUTH_LOGIN_PATH=/auth/login
# localStorage key the SPA reads its auth token from (token-based apps)
AUTH_TOKEN_STORAGE_KEY=kpost.authToken

# ---- Test user credentials (use non-production, seeded test accounts) ----
STANDARD_USER_EMAIL=standard.user@kpost.test
STANDARD_USER_PASSWORD=Str0ng-Passw0rd!

ADMIN_USER_EMAIL=admin.user@kpost.test
ADMIN_USER_PASSWORD=Str0ng-Admin-Passw0rd!

# ---- OPTIONAL: the account tests/auth/ signs in and out as ----
# KPost allows ONE active session per account. The auth specs drive the real
# login and logout flows, so whichever account they use loses its session — and
# if that is the standard user, the shared storageState the whole rest of the
# suite runs on dies with it and every later test fails as a logged-out session
# (measured 2026-08-27; it was the single largest source of red in the suite).
#
# Leave these blank and the auth specs use ADMIN_USER_*, which nothing else
# drives. Set them to give the auth journeys an account entirely of their own —
# do that as soon as any spec starts asserting on admin-specific behaviour.
AUTH_USER_EMAIL=
AUTH_USER_PASSWORD=

# ---- OPTIONAL: pre-onboarded KDirectory account ----
# KDirectory's search, contact list, and filters sit behind a one-time setup
# wizard (Country / Language / vertical). Completing it permanently onboards an
# account, so the standard user is deliberately left un-onboarded.
# Point these at an account that is ALREADY through the wizard and global setup
# will store a second session at .auth/directory.json, which the gated
# KDirectory specs use instead of skipping. Leave both unset to skip them.
# Set both or neither — half-configured fails fast at startup.
DIRECTORY_USER_EMAIL=
DIRECTORY_USER_PASSWORD=

# ---- OPTIONAL: recipient for the KMail send E2E test ----
# KPost rejects sending a mail to yourself ("Duplicate IDs are present in
# ToAddress..."), so the full send-success journey needs a SECOND KPOST account
# to address. It MUST be a different account than STANDARD_USER_EMAIL —
# setting it to the same address is a guaranteed rejection and the test will
# skip and tell you so. Leave unset and that test skips (the self-send
# rejection contract test still covers the whole compose/send pipeline).
MAIL_RECIPIENT=

# ---- OPTIONAL: external QA Dashboard (the separate QA-Dashboard repo) ----
# When both are set, every Playwright run posts its summary and the known
# defects it observed to POST {DASHBOARD_INGEST_URL} with
# "Authorization: Bearer {DASHBOARD_API_KEY}" (see src/reporting/
# dashboard-reporter.ts). Leave both unset and the reporter no-ops; set only
# one and startup fails fast. A dashboard outage never fails a run — the
# local BUG_REPORT.md and playwright-report/ stay the reference either way.
#
# The key is issued per application on the dashboard's Applications page. This
# bench reports as the application with slug `kpost-ui` — use that application's
# key, not the API bench's, or the two suites' results merge into one row.
#
# A listing run (`npm run test:list`, or a --grep that matches nothing) executes
# no tests and deliberately posts NOTHING.
DASHBOARD_INGEST_URL=http://localhost:8081/api/ingest
# Leave BLANK here. A real key belongs only in .env (gitignored) — an example
# file that carries a live credential leaks it into every clone of the repo.
DASHBOARD_API_KEY=

# Optional: the URL a person's BROWSER can reach the dashboard's own UI at.
# Defaults to DASHBOARD_INGEST_URL's origin, which is wrong whenever ingest
# goes over `localhost` — set this explicitly in that case. Used to link a
# defect's own /defects/:id evidence page (real <video> playback, unlike
# Bugzilla's attachments) from each filed Bugzilla ticket's description.
DASHBOARD_PUBLIC_URL=http://192.168.0.50:8081

# ---- OPTIONAL: Bugzilla (the shared BUGZILLA-UI-fronted instance) ---------
# Files known defects into the "KPost UI" Bugzilla product (product id 3 —
# separate from the API bench's "KPost API" product, so the two benches never
# share or collide on tickets; see src/reporting/bugzilla-reporter.ts). Every
# component in "KPost UI" already carries a default assignee (Ayyappan Ashok),
# so this bench never sets assigned_to itself. Leave both unset and the
# reporter no-ops; set only one and startup fails fast. BUGZILLA_DRY_RUN
# defaults to true — filing real tickets is an explicit opt-in.
# The REST endpoint, verified reachable at the server ROOT (not under /bugzilla):
#   curl http://192.168.0.50/rest/version  ->  {"version":"5.2"}
BUGZILLA_URL=http://192.168.0.50/rest
# WHOSE key this is decides the REPORTER on every filed ticket — Bugzilla records
# the authenticated user and offers no override. Use the QA account's key so bugs
# are reported by QA. The ASSIGNEE is separate: bug creation omits assigned_to, so
# Bugzilla applies each component's default owner (the developer for that module).
BUGZILLA_API_KEY=
BUGZILLA_PRODUCT=KPost UI
BUGZILLA_VERSION=unspecified
BUGZILLA_DRY_RUN=true

# Who defects found by this bench are assigned to — shown as Owner in
# BUG_REPORT.* and on the QA dashboard. Defaults to the UI team lead, since
# every defect this bench can find is a KPost UI defect. A single defect can
# override it with an `owner` on its registry entry in src/utils/known-defects.ts.
DEFECT_OWNER=Ayyappan

# ---- Execution tuning ----
# Number of parallel workers (empty = Playwright auto-detects)
WORKERS=
# Retry count for flaky tests (overrides config default when set)
RETRIES=
# Run browsers headless (true/false)
HEADLESS=true
# Slow down each action by N ms — useful for debugging only
SLOW_MO=0
