{
  "name": "kpost-ui",
  "version": "1.0.0",
  "description": "Production-grade Playwright + TypeScript UI test automation framework for the KPost React application.",
  "author": "KPost QA Automation",
  "license": "UNLICENSED",
  "private": true,
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "test": "playwright test",
    "test:headed": "playwright test --headed",
    "test:debug": "cross-env PWDEBUG=1 playwright test",
    "test:ui": "playwright test --ui",
    "test:chromium": "playwright test --project=chromium",
    "test:firefox": "playwright test --project=firefox",
    "test:webkit": "playwright test --project=webkit",
    "test:mobile": "playwright test --project=mobile-chrome",
    "test:smoke": "playwright test --grep @smoke",
    "test:regression": "playwright test --grep @regression",
    "test:auth": "playwright test tests/auth",
    "test:home": "playwright test tests/home",
    "test:kmail": "playwright test tests/kmail",
    "test:kdirectory": "playwright test tests/kdirectory",
    "test:katchup": "playwright test tests/katchup",
    "test:settings": "playwright test tests/settings",
    "test:kecommerce": "playwright test tests/kecommerce",
    "test:knews": "playwright test tests/knews",
    "test:kpay": "playwright test tests/kpay",
    "test:parallel": "playwright test --workers=4",
    "test:serial": "playwright test --workers=1",
    "test:list": "playwright test --list --reporter=list",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "report": "playwright show-report --port 9324",
    "digest": "node scripts/print-digest.js",
    "trace": "playwright show-trace",
    "codegen": "playwright codegen http://localhost:3000",
    "lint": "eslint . --ext .ts",
    "lint:fix": "eslint . --ext .ts --fix",
    "format": "prettier --write \"**/*.{ts,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,json,md}\"",
    "typecheck": "tsc --noEmit",
    "clean": "rimraf playwright-report test-results .auth",
    "ci": "npm run typecheck && npm run lint && npm run test:unit && npm run test"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@faker-js/faker": "^9.3.0",
    "@playwright/test": "^1.49.1",
    "@types/node": "^22.10.5",
    "@typescript-eslint/eslint-plugin": "^8.19.1",
    "@typescript-eslint/parser": "^8.19.1",
    "cross-env": "^10.1.0",
    "dotenv": "^16.4.7",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-playwright": "^2.1.0",
    "prettier": "^3.4.2",
    "rimraf": "^6.0.1",
    "ts-api-utils": "2.4.0",
    "typescript": "^5.7.3",
    "vitest": "^4.1.10",
    "wait-on": "^8.0.1"
  }
}
